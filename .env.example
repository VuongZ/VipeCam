# Copy the Neon PostgreSQL connection string into .env.local. Never commit it.
DATABASE_URL=
# Optional dedicated local PostgreSQL connection for regression tests.
TEST_DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# local is development-only. Production uploads require r2.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Only for the interactive admin:create script; never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
